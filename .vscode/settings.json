{
  // Pin the interpreter so discovery never falls back to the Windows pyenv shim
  // that WSL puts on PATH; that interpreter cannot import this project's deps.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Activate .venv in every new integrated terminal, so opening the folder is
  // the only setup step. Default is true; pinned here so a user-level override
  // cannot silently break the documented workflow.
  "python.terminal.activateEnvironment": true,

  // Large generated/vendored trees in this repo (measured): .venv 1.5G, .cache 499M,
  // exports 173M, cad 98M. Excluding them from watching/searching/indexing keeps the
  // extension host (especially over WSL Remote) from walking ~25k files on every load.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/.cache/**": true,
    "**/exports/**": true,
    "**/cad/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/node_modules/**": true
  },

  "search.exclude": {
    "**/.venv": true,
    "**/.cache": true,
    "**/exports": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.stp": true
  },

  // Pylance: don't index the 1.5G virtualenv or generated mesh/CAD output.
  // This setting REPLACES Pylance's defaults rather than extending them, so the first
  // four entries restore them; "**/.*" is what covers .venv, .cache and the tool caches.
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git",
    "**/.*",
    "**/exports/**",
    "**/cad/**"
  ],

  // The viewers serve Meshcat on 7000, stepping up when that port is taken. Pinning the
  // range here means the "open in browser" prompt is a property of the repo rather than of
  // whatever port-forwarding defaults a given machine happens to have.
  "remote.autoForwardPorts": true,
  "remote.portsAttributes": {
    "7000-7010": {
      "label": "Meshcat viewer",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  // "notify" only fires the toast when a port is forwarded for the first time. Restoring
  // ports puts 7000 back in the list at window open, so by the time a viewer starts there
  // is nothing new to announce and the prompt never appears. Starting clean each session
  // is what makes every viewer launch offer to open itself.
  "remote.restoreForwardedPorts": false,

  // STEP files are LFS-backed and up to ~95 MB; never treat them as editable text.
  "files.associations": {
    "*.stp": "plaintext"
  },
  "files.readonlyInclude": {
    "**/*.stp": true
  },
  "editor.largeFileOptimizations": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
